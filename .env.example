# Robot connection
SESAME_ROBOT_IP=192.168.100.97

# AI API keys and model
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key_here

# Voice and speech
VOICE_ENABLED=true
TTS_ENGINE=piper
# Local faster-whisper model: 'tiny' (fastest CPU response) or 'base' (higher accuracy, both cached in models/whisper)
WHISPER_MODEL=tiny
PIPER_VOICE=en_US-lessac-medium
# Optional: select a microphone from SpeechRecognition's device list
# MIC_DEVICE_INDEX=5
# MIC_DEVICE_NAME=Microphone Array
WAKE_WORD=hey sesame
WAKE_WORD_MODE=true
