# Robot connection
SESAME_ROBOT_IP=192.168.100.97

# AI API keys and Brain Mode ('auto' = Cloud with Offline Ollama failover, 'ollama' = 100% offline, 'groq' = cloud)
AI_PROVIDER=auto
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_NUM_CTX=512
OLLAMA_NUM_THREADS=2
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key_here

# Voice and speech 
VOICE_ENABLED=true
VOICE_LANGUAGE=en
MIC_ENERGY_THRESHOLD=4000
TTS_ENGINE=piper
# Local faster-whisper model: 'tiny' (fastest CPU response) or 'base' (higher accuracy, both cached in models/whisper)
WHISPER_MODEL=tiny
# Local Piper neural voice: 'en_US-lessac-low' (fastest CPU synth) or 'en_US-lessac-medium' (both cached in models/piper)
PIPER_VOICE=en_US-lessac-low
# Voice character for Piper: 'cute' (childlike buddy, default), 'silly' (extra goofy cartoon), or 'natural'
PIPER_VOICE_STYLE=cute
# Optional: select a microphone from SpeechRecognition's device list
# MIC_DEVICE_INDEX=5
# MIC_DEVICE_NAME=Microphone Array
WAKE_WORD=hey sesame
WAKE_WORD_MODE=false
